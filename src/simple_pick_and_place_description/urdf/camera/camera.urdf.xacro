<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wrist_camera" params="arm_prefix">

    <!-- Camera link gắn vào fr3_hand -->
    <link name="${arm_prefix}fr3_cam_link">
      <visual>
        <geometry><box size="0.03 0.07 0.03"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- Joint gắn camera vào tay -->
    <joint name="${arm_prefix}fr3_cam_joint" type="fixed">
      <parent link="${arm_prefix}fr3_hand"/>
      <child link="${arm_prefix}fr3_cam_link"/>
      <origin xyz="0.06 0 0.04" rpy="3.14159 -1.5708 0"/>
    </joint>

    <!-- Optical frame (Z forward, X right, Y down) -->
    <link name="${arm_prefix}fr3_cam_optical_frame"/>
    <joint name="${arm_prefix}fr3_cam_optical_joint" type="fixed">
      <parent link="${arm_prefix}fr3_cam_link"/>
      <child link="${arm_prefix}fr3_cam_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <!-- Gazebo RGBD camera plugin -->
    <gazebo reference="${arm_prefix}fr3_cam_link">
      <sensor name="fr3_rgbd_cam" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>5.0</far></clip>
        </camera>
        <topic>fr3_cam</topic>
        <gz_frame_id>${arm_prefix}fr3_cam_optical_frame</gz_frame_id>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
